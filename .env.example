# Shared HubSpot private app token — same portal as alis-hub.
# The Contract Truth view needs crm.objects.line_items.read and
# crm.schemas.line_items.read scopes on this token, in addition to the
# scopes alis-hub already uses (companies/deals/tickets read). As of
# 2026-09-03 the token alis-hub uses is MISSING those two scopes (see
# server/automation/usageAudit.js in alis-hub) — add them in HubSpot's
# private app settings and regenerate the token before Contract Truth
# will return real line-item data here.
HUBSPOT_PRIVATE_APP_TOKEN=

# Used to build clickable links back to HubSpot records (deals, companies).
HUBSPOT_PORTAL_ID=

PORT=3100
